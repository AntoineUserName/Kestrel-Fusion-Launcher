State ConnectionWithNumbs() {
    
    Actions
    {
        

        While (true) {
            
            // wait(0.1);

            if(unusedJob.GetValue(jobForModsKey) != 2 && canReceiveNewMsg) {
            // if(unusedJob.GetValue(jobForModsKey) != 2) {

                canReceiveNewMsg = false;
                // lastStrValue = "S_" + communicationIMod;



                communicationIMod = "";

                lastJobNumberValue = unusedJob.GetValue(jobForModsKey);

                // 49 50 51 01 = abc

                Text tempTxt("");

                
                While (lastJobNumberValue != 1) {

                    unusedJob.SetValue(jobForModsKey, 2);

                    if(lastJobNumberValue >= 5) {

                        // tempTxt = convNumberToLetter(lastJobNumberValue - 5);
                        // communicationIMod = communicationIMod + tempTxt;

                        communicationIMod = communicationIMod + convNumberToLetter(lastJobNumberValue - 5);

                    }
                    

                    While (unusedJob.GetValue(jobForModsKey) == 2) {
                        
                    };
                    
                    lastJobNumberValue = unusedJob.GetValue(jobForModsKey);
                    
                    
                    
                };


                // Parsing a string sent with numbers:


                // first string sent:
                Text requestType( communicationIMod );

                

                
                // CityArray numberArgs( CityArray_Create("Number") );
                // CityArray textArgs( CityArray_Create("Text") );

                JS_C_API_numberArgs.Clear();
                JS_C_API_textArgs.Clear();
                
                Bool continueMsgLoop(true);

                Number floatSendedNumber(0); // If need to send a float number, this number will be sended by multiples messages (a message for the float part and a second for the int part);
                Bool receivingNegativeN(false);

                Number paramTypeNbr(0);


                // For say that the message is received :
                lastJobNumberValue = 2;
                unusedJob.SetValue(jobForModsKey, lastJobNumberValue);

                While (continueMsgLoop) {
                    
                    // // For say that the message is received :
                    // lastJobNumberValue = 2;
                    // unusedJob.SetValue(jobForModsKey, lastJobNumberValue);
                    
                    // While (unusedJob.GetValue(jobForModsKey) == lastJobNumberValue) {};
                    While (unusedJob.GetValue(jobForModsKey) == 2) {};

                    
                    paramTypeNbr = unusedJob.GetValue(jobForModsKey);
                    // lastStrValue = "S_" + communicationIMod;

                    // its the right behavour, need to check that its NOT 1 :
                    if(paramTypeNbr != 1) {


                        lastJobNumberValue = 2;
                        unusedJob.SetValue(jobForModsKey, lastJobNumberValue);
                        While (unusedJob.GetValue(jobForModsKey) == lastJobNumberValue) {};

                    }
                    

                    lastJobNumberValue = unusedJob.GetValue(jobForModsKey);
                    // lastStrValue = "S_" + communicationIMod;

                    
                    // For say that the message is received :
                    unusedJob.SetValue(jobForModsKey, 2);

                    // If its an int message :
                    if(paramTypeNbr == 4) {

                        // Number intToSend( lastJobNumberValue );
                        Number intToSend( lastJobNumberValue - 5);

                        // for negative numbers messages :
                        if(receivingNegativeN) {
                            intToSend = intToSend * -1;
                            receivingNegativeN = false;
                        }

                        if(floatSendedNumber == 0) {
                            JS_C_API_numberArgs.Add(intToSend);
                        } else {
                            // If is sending a float increment the float and add it to the list :
                            floatSendedNumber = floatSendedNumber + intToSend;
                            
                            JS_C_API_numberArgs.Add(floatSendedNumber);
                            floatSendedNumber = 0;
                        }
                    } else {


                        // fast float:
                        if(paramTypeNbr == 7) {
                            
                            JS_C_API_numberArgs.Add((lastJobNumberValue / 100) - 1000);

                        } elseif(paramTypeNbr == 5) {
                            // floatSendedNumber = floatSendedNumber + (lastJobNumberValue * 0.0000001);
                            floatSendedNumber = floatSendedNumber + ((lastJobNumberValue - 5) * 0.0000001);
                        } else {
                            
                            if(paramTypeNbr == 6) {
                                // for negative numbers
                                receivingNegativeN = true;
                                // floatSendedNumber = floatSendedNumber + (lastJobNumberValue * -0.0000001);
                                floatSendedNumber = floatSendedNumber + ((lastJobNumberValue - 5) * -0.0000001);
                            } else {

                                if(paramTypeNbr == 1) {
                                    // If the message finished :
                                    continueMsgLoop = false;

                                } elseif(paramTypeNbr == 8) {

                                    // for 8:

                                    // If its a text message :
                                    
                                    
                                    communicationIMod = "";

                                    // unusedJob.SetValue(jobForModsKey, 2);
                                    
                                    // While (unusedJob.GetValue(jobForModsKey) == 2) {
                                        
                                    // };

                                    // lastJobNumberValue = unusedJob.GetValue(jobForModsKey);

                                    // tempTxt = "";
                                    
                                    While (lastJobNumberValue != 1) {

                                        // unusedJob.SetValue(jobForModsKey, 2);


                                        communicationIMod = communicationIMod + convNumberToLetter(lastJobNumberValue - 5);

                                        // if(lastJobNumberValue >= 5) {

                                            // communicationIMod = communicationIMod + convNumberToLetter(lastJobNumberValue - 5);
                                            
                                            // tempTxt = convNumberToLetter(lastJobNumberValue - 5);
                                            // communicationIMod = communicationIMod + tempTxt;
                                        // }
                                        

                                        While (unusedJob.GetValue(jobForModsKey) == 2) {
                                            
                                        };
                                        
                                        lastJobNumberValue = unusedJob.GetValue(jobForModsKey);

                                        unusedJob.SetValue(jobForModsKey, 2);
                                        
                                    };
                                    

                                    JS_C_API_textArgs.Add(communicationIMod);
                                    
                                    // unusedJob.SetValue(jobForModsKey, 2);
                                }
                            }
                        }
                    }
                };

                // WHEN MESSAGE FINISHED :

                // lastJobNumberValue = 2;
                // unusedJob.SetValue(jobForModsKey, 2);

                JS_C_API_modId = requestType;
                JS_C_API_gotMsg = true;
                // While (JS_C_API_modId != "") { // wait that a mod intercept the request;
                While (JS_C_API_gotMsg) { // wait that a mod intercept the request;
                    wait(0.04);
                };
                // JS_C_API_gotMsg = false;

                // For say that the message is received :
                

                // lastJobNumberValue = cCodeMsgRECEIVED;
                // unusedJob.SetValue(jobForModsKey, cCodeMsgRECEIVED);

                canReceiveNewMsg = true;

            } else {

                

                
                
        
                if( C_API_SendDatas.Size() != 0 && canReceiveNewMsg && unusedJob.GetValue(jobForModsKey) == 2 ) {

                // for usingKeepSizeSendDList :
                // if( C_API_SendDatas.Get(0) != 0 && canReceiveNewMsg && unusedJob.GetValue(jobForModsKey) == 2 ) {

                    canReceiveNewMsg = false;

                    unusedJob.SetValue(jobForModsKey, 3);


                    Number maxIndexArgR(C_API_SendDatas.Get(0));
                    
                    
                    // for usingKeepSizeSendDList :
                    // if(C_API_SendDatas.Get(maxIndexArgR) == 0 ) {
                    
                    if(C_API_SendDatas.Size() < maxIndexArgR) {

                        While (C_API_SendDatas.Size() < maxIndexArgR) {
                        
                        // for usingKeepSizeSendDList :
                        // While( C_API_SendDatas.Get(maxIndexArgR) == 0 ) {

                            wait(0.1);
                            maxIndexArgR = C_API_SendDatas.Get(0);
                        };
                    }

                    
                    Number indexArgR(1);
                    // Number indexArgR(0);

                    
                    C_API_SendDatas.Remove(0);

                    While (indexArgR < maxIndexArgR) {
                        
                        While (unusedJob.GetValue(jobForModsKey) != 1) {
                        };

                        // unusedJob.SetValue(jobForModsKey, C_API_SendDatas.Get(indexArgR));
                        
                        Number argToSend( C_API_SendDatas.Get(0) );

                        unusedJob.SetValue(jobForModsKey, argToSend);

                        C_API_SendDatas.Remove(0);

                        indexArgR = indexArgR + 1;

                    };

                    While (unusedJob.GetValue(jobForModsKey) != 1) {
                    };

                    unusedJob.SetValue(jobForModsKey, 2);

                    if(usingKeepSizeSendDList) {
                        While (C_API_SendDatas.Size() < minSendDatasListSize) {
                            C_API_SendDatas.Add(0);
                        };

                        C_SendDatasListSize = C_SendDatasListSize - maxIndexArgR;
                    }

                    canReceiveNewMsg = true;

                }

            }


        }

    };
};



State Base() {
    Actions
    {

        wait(5);


        unusedJob.SetValue(jobForModsKey, 465412);

        wait(0.5);

        Bool phaseFirst(true);

        While (unusedJob.GetValue(jobForModsKey) != 321789) {


            if(phaseFirst) {

                unusedJob.SetValue(jobForModsKey, 20);

            } else {
                
                unusedJob.SetValue(jobForModsKey, 465412);

            }

            phaseFirst = phaseFirst == false;


            wait(1.8); // let the time to the other code to see that the variable changed values;
            // need to be more than 0.8s;
        };



        lastJobNumberValue = 2;
        unusedJob.SetValue(jobForModsKey, 2);

        wait(0.1);

        // UI_ShowObjectiveScreen ( true, "INIT_KF_MODDED_TEXT_1", 14, false );
        

        if(usingKeepSizeSendDList) {
            While (C_API_SendDatas.Size() < minSendDatasListSize) {
                C_API_SendDatas.Add(0);
            };
        }


        canReceiveNewMsg = true;

        goto ConnectionWithNumbs();
        
        
    };
};



Base();