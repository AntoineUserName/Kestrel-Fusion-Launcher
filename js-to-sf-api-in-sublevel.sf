Function convNumberToLetter (Number n) returns Text
{


    if(n > 91) {


        // was making script not working:
        // if(n == 92) { return "\\"; }
        
        if(n == 93) { return "]"; }
        if(n == 94) { return "^"; }
        if(n == 95) { return "_"; }
        if(n == 96) { return "`"; }
        if(n == 97) { return "a"; }
        if(n == 98) { return "b"; }
        if(n == 99) { return "c"; }
        if(n == 100) { return "d"; }
        if(n == 101) { return "e"; }
        if(n == 102) { return "f"; }
        if(n == 103) { return "g"; }
        if(n == 104) { return "h"; }
        if(n == 105) { return "i"; }
        if(n == 106) { return "j"; }
        if(n == 107) { return "k"; }
        if(n == 108) { return "l"; }
        if(n == 109) { return "m"; }
        if(n == 110) { return "n"; }
        if(n == 111) { return "o"; }
        if(n == 112) { return "p"; }
        if(n == 113) { return "q"; }
        if(n == 114) { return "r"; }
        if(n == 115) { return "s"; }
        if(n == 116) { return "t"; }
        if(n == 117) { return "u"; }
        if(n == 118) { return "v"; }
        if(n == 119) { return "w"; }
        if(n == 120) { return "x"; }
        if(n == 121) { return "y"; }
        if(n == 122) { return "z"; }
        if(n == 123) { return "{"; }
        
        // // was making script not working:
        // if(n == 124) { return "|"; }

        if(n == 125) { return "}"; }

        // // was making script not working:
        // if(n == 126) { return "~"; }

    }
    elseif(n > 64) {


        if(n == 65) { return "A"; }
        if(n == 66) { return "B"; }
        if(n == 67) { return "C"; }
        if(n == 68) { return "D"; }
        if(n == 69) { return "E"; }
        if(n == 70) { return "F"; }
        if(n == 71) { return "G"; }
        if(n == 72) { return "H"; }
        if(n == 73) { return "I"; }
        if(n == 74) { return "J"; }
        if(n == 75) { return "K"; }
        if(n == 76) { return "L"; }
        if(n == 77) { return "M"; }
        if(n == 78) { return "N"; }
        if(n == 79) { return "O"; }
        if(n == 80) { return "P"; }
        if(n == 81) { return "Q"; }
        if(n == 82) { return "R"; }
        if(n == 83) { return "S"; }
        if(n == 84) { return "T"; }
        if(n == 85) { return "U"; }
        if(n == 86) { return "V"; }
        if(n == 87) { return "W"; }
        if(n == 88) { return "X"; }
        if(n == 89) { return "Y"; }
        if(n == 90) { return "Z"; }
        if(n == 91) { return "["; }

    }
    elseif(n > 47) {


        if(n == 48) { return "0"; }
        if(n == 49) { return "1"; }
        if(n == 50) { return "2"; }
        if(n == 51) { return "3"; }
        if(n == 52) { return "4"; }
        if(n == 53) { return "5"; }
        if(n == 54) { return "6"; }
        if(n == 55) { return "7"; }
        if(n == 56) { return "8"; }
        if(n == 57) { return "9"; }
        if(n == 58) { return ":"; }
        if(n == 59) { return ";"; }
        if(n == 60) { return "<"; }
        if(n == 61) { return "="; }
        if(n == 62) { return ">"; }
        if(n == 63) { return "?"; }
        if(n == 64) { return "@"; }

    }
    else {

        if(n == 32) { return " "; }
        if(n == 33) { return "!"; }

        // // was making script not working:
        // if(n == 34) { return "\""; }
        
        if(n == 35) { return "#"; }
        if(n == 36) { return "$"; }
        if(n == 37) { return "%"; }
        if(n == 38) { return "&"; }
        if(n == 39) { return "'"; }
        if(n == 40) { return "("; }
        if(n == 41) { return ")"; }
        if(n == 42) { return "*"; }
        if(n == 43) { return "+"; }
        if(n == 44) { return ","; }
        if(n == 45) { return "-"; }
        if(n == 46) { return "."; }
        if(n == 47) { return "/"; }
        
        


    }

    return "";
};



